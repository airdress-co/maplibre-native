+    const auto [lngA, latA] = solve(intersectionA);
+    const auto [lngB, latB] = solve(intersectionB);
+
+    constexpr double limit = std::numbers::pi * 0.5;
+    const bool validA = latA >= -limit && latA <= limit;
+    const bool validB = latB >= -limit && latB <= limit;
