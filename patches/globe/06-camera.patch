+    x0 /= len0;
+    y0 /= len0;
+    x1 /= len1;
+    y1 /= len1;
+    const double cross = x0 * y1 - x1 * y0;
+    const double angle = std::acos(std::clamp(x0 * x1 + y0 * y1, -1.0, 1.0));
+    return cross > 0 ? angle : -angle;
