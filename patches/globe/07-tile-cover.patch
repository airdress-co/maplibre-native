+    std::sort(
+        result.begin(), result.end(), [](const ResultTile& a, const ResultTile& b) { return a.sqrDist < b.sqrDist; });
+    std::vector<OverscaledTileID> ids;
+    ids.reserve(result.size());
+    for (const auto& tile : result) {
+        ids.push_back(tile.id);
+    }
+    return ids;
+}
