diff --git a/platform/ios/CHANGELOG.md b/platform/ios/CHANGELOG.md
index bb0b2fc39e45c36cd245f329e08f233dfbdda7b3..231a5e2e9922874b4d2e38dfdcce866666686fc2 100644
