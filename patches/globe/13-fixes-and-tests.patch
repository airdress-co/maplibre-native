+        "type": "Feature",
+        "properties": {},
+        "geometry": {
+          "type": "Polygon",
+          "coordinates": [
+            [
+              [
+                150,
+                -15
+              ],
+              [
+                210,
+                -15
+              ],
+              [
+                210,
+                15
+              ],
+              [
+                150,
+                15
+              ],
+              [
+                150,
+                -15
+              ]
+            ]
+          ]
+        }
+      }
+    }
+  },
+  "layers": [
+    {
+      "id": "background",
+      "type": "background",
+      "paint": {
