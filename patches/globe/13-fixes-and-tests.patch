--- /dev/null
+++ b/metrics/integration/render-tests/projection/globe/antimeridian-overdraw/line-gradient/style.json
@@ -0,0 +1,77 @@
+{
+  "version": 8,
+  "metadata": {
+    "test": {
+      "description": "Gradient lines at the antimeridian seam, magnified via a maxzoom 0 source (canonical zoom 0 data). One line crosses the seam, one runs along lon 180 itself, one crosses diagonally. All must be uniform 50% translucent, never double-blended by the wrapped buffer copy, and continuous across the seam.",
+      "width": 512,
+      "height": 512
+    }
+  },
+  "sky": { "atmosphere-blend": 0.0 },
+  "center": [180, 5],
+  "zoom": 1.8,
+  "projection": { "type": "globe" },
+  "sources": {
+    "lines": {
+      "type": "geojson",
+      "maxzoom": 0,
+      "lineMetrics": true,
+      "data": {
+        "type": "FeatureCollection",
+        "features": [
+          {
+            "type": "Feature",
+            "properties": {},
+            "geometry": {
+              "type": "LineString",
+              "coordinates": [[150, 25], [210, 25]]
+            }
+          },
+          {
+            "type": "Feature",
+            "properties": {},
+            "geometry": {
+              "type": "LineString",
+              "coordinates": [[180, -25], [180, 45]]
+            }
+          },
+          {
+            "type": "Feature",
+            "properties": {},
+            "geometry": {
+              "type": "LineString",
+              "coordinates": [[150, -20], [210, 15]]
+            }
+          }
+        ]
+      }
+    }
+  },
+  "layers": [
+    {
+      "id": "background",
+      "type": "background",
+      "paint": {
+        "background-color": "white"
+      }
+    },
+    {
+      "id": "line",
+      "type": "line",
+      "source": "lines",
+      "paint": {
+        "line-width": 10,
+        "line-opacity": 0.5,
+        "line-gradient": [
+          "interpolate",
+          ["linear"],
+          ["line-progress"],
+          0, "blue",
+          0.35, "cyan",
+          0.65, "yellow",
+          1, "red"
+        ]
+      }
+    }
+  ]
+}
