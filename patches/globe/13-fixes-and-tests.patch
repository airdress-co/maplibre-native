@@ -0,0 +1,59 @@
+{
+  "version": 8,
+  "metadata": {
+    "test": {
+      "description": "Tests that the globe can be centered on the north pole, and that dashed lines keep their dash length there.",
+      "width": 512,
+      "height": 512
+    }
+  },
+  "center": [
+    0.0,
+    90.0
+  ],
+  "zoom": -0.5,
+  "projection": {
+    "type": "globe"
+  },
+  "sources": {
+    "vector_tiles": {
+      "type": "vector",
+      "maxzoom": 0,
+      "tiles": [
+        "local://tiles/{z}-{x}-{y}.mvt"
+      ]
+    }
+  },
+  "layers": [
+    {
+      "id": "background",
+      "type": "background",
+      "paint": {
+        "background-color": "white"
+      }
+    },
+    {
+      "id": "land",
+      "type": "fill",
+      "source": "vector_tiles",
+      "source-layer": "water",
+      "paint": {
+        "fill-color": "blue"
+      }
+    },
+    {
+      "id": "admin",
+      "type": "line",
+      "source": "vector_tiles",
+      "source-layer": "admin",
+      "paint": {
+        "line-color": "red",
+        "line-width": 2,
+        "line-dasharray": [
+          2,
+          2
+        ]
+      }
+    }
+  ]
+}
