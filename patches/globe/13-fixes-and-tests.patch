+std::array<float, 2> RenderTile::tileUnitTranslation(const UnwrappedTileID& id,
+                                                     const std::array<float, 2>& translation,
+                                                     TranslateAnchorType anchor,
+                                                     const TransformState& state) {
+    if (translation[0] == 0 && translation[1] == 0) {
