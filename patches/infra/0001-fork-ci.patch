-    directories:
-      - '*'
-    schedule:
-      interval: 'weekly'
-    ignore:
-      - dependency-name: 'io.github.vvb2060.ndk:curl'
-    groups:
-      gradle-deps:
-        patterns:
-          - '*'
-    cooldown:
-      default-days: 5
-      semver-major-days: 5
-      semver-minor-days: 3
-      semver-patch-days: 3
