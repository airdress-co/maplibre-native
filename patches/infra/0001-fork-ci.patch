-version: 2
-updates:
-  - package-ecosystem: 'github-actions'
-    open-pull-requests-limit: 1
-    directory: '/'
-    schedule:
-      interval: 'weekly'
-    ignore:
-      - dependency-name: 'codecov/codecov-action'
